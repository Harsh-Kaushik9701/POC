# PostgreSQL connection (docker compose in this repo exposes this)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopfloor

# Secret used to sign login cookies. Change it for anything beyond a local demo.
SESSION_SECRET=change-me-to-a-long-random-string

# Demo clock. The app pretends "now" is this Brisbane local time when the server starts,
# then the clock runs forward normally. This lets you demo mid-shift at any hour.
# Leave empty to use the real time.
DEMO_NOW=2026-10-06 10:45
